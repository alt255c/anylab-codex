			<AfterExperimentCode><![CDATA[Collections.sort(MyCollection, (tuple1, tuple2) ->
    Double.compare(((MyAgent) tuple1).getParameter("db_1"),
                   ((MyAgent) tuple2).getParameter("db_1")));

for (Object obj : MyCollection) {
    MyAgent m = (MyAgent) obj;
    System.out.println("Интенсивность = " + m.getParameter("db_1") +
        ", Турникет1 = " + m.getParameter("db_2") +
        ", Турникет2 = " + m.getParameter("db_3") +
        ", Касса1 = " + m.getParameter("db_4") +
        ", Касса2 = " + m.getParameter("db_5"));
}

for (Object obj : MyCollection) {
    MyAgent m = (MyAgent) obj;
    Турникет1.add(m.getParameter("db_1"), m.getParameter("db_2"));
    Турникет2.add(m.getParameter("db_1"), m.getParameter("db_3"));
    Касса1.add(m.getParameter("db_1"), m.getParameter("db_4"));
    Касса2.add(m.getParameter("db_1"), m.getParameter("db_5"));
}]]></AfterExperimentCode>
