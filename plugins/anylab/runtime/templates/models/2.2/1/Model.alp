			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790451297387</Id>
					<Name><![CDATA[Расчет_пропускной_способности]]></Name>
					<X>70</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double total = Время_в_S0 + Время_в_S1 + Время_в_S2 + Время_в_S3 + Время_в_S4;
if (total == 0) return 0;
double p0 = Время_в_S0 / total;
double p1 = Время_в_S1 / total;
double p2 = Время_в_S2 / total;
double p3 = Время_в_S3 / total;
double p4 = Время_в_S4 / total;
double throughput = (p0 * k + p1 * (k - 1) + p2 * (k - 2) + p3 * (k - 3) + p4 * 0) / k;
return throughput * 100;]]></Body>
				</Function>
			</Functions>

