			<AfterExperimentCode><![CDATA[// Очистить наборы данных от предыдущих запусков
MinData.reset();
AvgData.reset();
MaxData.reset();

// Отсортировать коллекцию
Collections.sort(MyCollection, (a, b) -> Double.compare(a.getDb_1(), b.getDb_1()));

// Заполнить наборы
double x = 0, Ymin = 0, Y = 0, Ymax = 0;
int N = 0;
boolean first = true;
for (int i = 0; i < MyCollection.size(); i++) {
    double Z = MyCollection.get(i).getDb_1();
    double val = MyCollection.get(i).getDb_2();
    if (first || x != Z) {
        if (N != 0) {
            MinData.add(x, Ymin);
            AvgData.add(x, Y / N);
            MaxData.add(x, Ymax);
        }
        x = Z; Ymin = val; Ymax = val; Y = val; N = 1;
        first = false;
    } else {
        N++; Y += val;
        if (val < Ymin) Ymin = val;
        if (val > Ymax) Ymax = val;
    }
}
if (N != 0) {
    MinData.add(x, Ymin);
    AvgData.add(x, Y / N);
    MaxData.add(x, Ymax);
}

traceln("=== Итоговая таблица ===");
traceln("P1\tMin\tAvg\tMax\tРазброс");
for (int i = 0; i < MinData.size(); i++) {
    double a = MinData.getX(i);
    double ymin = MinData.getY(i);
    double yavg = AvgData.getY(i);
    double ymax = MaxData.getY(i);
    traceln(a + "\t" + ymin + "\t" + yavg + "\t" + ymax + "\t" + (ymax - ymin));
}]]></AfterExperimentCode>
