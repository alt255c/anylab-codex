		<!--   =========   Simulation Experiment   ========  -->
		<SimulationExperiment ActiveObjectClassId="1790446174796">
			<Id>1790446174802</Id>
			<Name><![CDATA[Simulation]]></Name>
			<CommandLineArguments/>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[double total = root.Время_в_S0 + root.Время_в_S1 + root.Время_в_S2 
             + root.Время_в_S3 + root.Время_в_S4;
root.p0 = root.Время_в_S0 / total;
root.p1 = root.Время_в_S1 / total;
root.p2 = root.Время_в_S2 / total;
root.p3 = root.Время_в_S3 / total;
root.p4 = root.Время_в_S4 / total;

traceln("p0 = " + root.p0);
traceln("p1 = " + root.p1);
traceln("p2 = " + root.p2);
traceln("p3 = " + root.p3);
traceln("p4 = " + root.p4);
double throughput = (root.Время_в_S0 * 4 + root.Время_в_S1 * 3 
                   + root.Время_в_S2 * 2 + root.Время_в_S3 * 1) / total / 4 * 100;
traceln("Пропускная способность = " + throughput + "%");
root.Пропускная_способность = throughput;]]></AfterSimulationRunCode>
