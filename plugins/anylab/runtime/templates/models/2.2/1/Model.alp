			<AfterSimulationRunCode><![CDATA[double total = root.Время_в_S0 + root.Время_в_S1 + root.Время_в_S2 
             + root.Время_в_S3 + root.Время_в_S4;
double tp = (root.Время_в_S0 * 4 + root.Время_в_S1 * 3 
           + root.Время_в_S2 * 2 + root.Время_в_S3 * 1) / total / 4 * 100;
MyCollection.add(new MyAgent(root.P1, tp));]]></AfterSimulationRunCode>
