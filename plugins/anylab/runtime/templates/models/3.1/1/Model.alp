			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791138945142</Id>
					<Name><![CDATA[ПроверитьОкончаниеРозыгрыша]]></Name>
					<X>1510</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (ОбработаноБилетов == 50) {

    ДанныеАвтомобили.add(КоличествоАвтомобилей);
    ДанныеТехника.add(КоличествоТехники);
    ДанныеАксессуары.add(КоличествоАксессуаров);
    ДанныеСуммаВыигрыша.add(СуммаВыигрыша);
	
	if (ДанныеАвтомобили.count() == КоличествоЭкспериментов) {
        ВыводСтатистики();
    }
    
    ОбработаноБилетов = 0;

    КоличествоАвтомобилей = 0;
    КоличествоТехники = 0;
    КоличествоАксессуаров = 0;
    КоличествоБезВыигрыша = 0;
    СуммаВыигрыша = 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791139223892</Id>
					<Name><![CDATA[ВыводСтатистики]]></Name>
					<X>1510</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[traceln("Количество экспериментов = " + ДанныеАвтомобили.count());
traceln();
traceln("Автомобили:");
