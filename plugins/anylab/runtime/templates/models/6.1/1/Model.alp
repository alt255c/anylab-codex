	<Folders>
	</Folders>
	<ActiveObjectClasses>

		<ActiveObjectClass>
			<Id>1435825351348</Id>
			<Name>Main</Name>
			<StartupCode>navigate(view3D);

double горизонт=getEngine().getStopTime();
if(интенсивностьПрибытия&gt;0 &amp;&amp; горизонт&gt;0 &amp;&amp; горизонт&lt;=1440) {
 java.util.Random потокСпроса=new java.util.Random(625500L+номерПовтора);
 double момент=0;
 while (true) {
  момент-=Math.log(1-потокСпроса.nextDouble())/интенсивностьПрибытия;
  if(момент&gt;=горизонт) break;
  спрос++;
 }
}
</StartupCode>
