<Model>
	<Id>1435825351329</Id>
	<Name><![CDATA[АЗС 6.1]]></Name>
	<Description><![CDATA[Автозаправочная станция с четырьмя колонками и сравнением правил очереди.]]></Description>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName>gas_station</JavaPackageName>
	<ModelTimeUnit>Minute</ModelTimeUnit>
	<OptionLists>
		<OptionList>
			<Id>1435918145348</Id>
			<Name>FuelType</Name>
			<Option>
				<Id>1435918145349</Id>
