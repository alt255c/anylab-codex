						<Value Class="CodeValue"><Code>
Tank target = car.fuelType==GAS92 ? резервуарАИ92 : car.fuelType==GAS95 ? резервуарАИ95 : резервуарДТ;
target.set_maxRateOut(0,LITER_PER_SECOND);
car.уровеньДоСлива=target.amount(CUBIC_METER);
car.литражСлива=Math.max(0,Math.min(car.capacity,target.capacity(CUBIC_METER)-car.уровеньДоСлива));
последнийУровеньДо=car.уровеньДоСлива;
</Code></Value></Parameter>
