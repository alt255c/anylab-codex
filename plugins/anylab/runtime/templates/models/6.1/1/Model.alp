	<ParamVariationExperiment ActiveObjectClassId="1435825351348">
			<Id>1778677226362</Id>
			<Name>АнализИнтенсивности</Name>
			<CommandLineArguments/>
			<MaximumMemory>1024</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode>обычнаяОчередь.reset(); короткаяЗаправка.reset(); суммы=new double[2][5]; числа=new int[2][5];
суммыОбъезда=new double[2][5]; суммыОжидания=new double[2][5]; суммыЗагрузки=new double[2][5];
показатель1_0.reset(); показатель1_1.reset();
показатель2_0.reset(); показатель2_1.reset();
показатель3_0.reset(); показатель3_1.reset();</BeforeEachExperimentRunCode>
			<AfterSimulationRunCode>int i=(int)Math.round((root.интенсивностьПрибытия-1)); int p=root.правилоОчереди; суммы[p][i]+=root.served/30.0; числа[p][i]++;
traceln("LAB6;" + root.интенсивностьПрибытия + ";" + root.правилоОчереди + ";" + root.номерПовтора + ";" + root.спрос + ";" + root.arrived + ";" + root.допущено + ";" + root.served + ";" + root.bypassed + ";" + root.завершилиОбъезд + ";" + root.networkEntered + ";" + root.networkExited + ";" + root.roadStops + ";" + root.максимумОжидания + ";" + root.queueArea + ";" + root.busyArea + ";" + root.queueWaitTotal + ";" + root.queueDeparted + ";" + root.накопленоНаПодъезде + ";" + root.stationTimeTotal);
суммыОбъезда[p][i]+=root.bypassed*100.0/Math.max(1,root.arrived);
суммыОжидания[p][i]+=root.queueWaitTotal*60/Math.max(1,root.queueDeparted);
суммыЗагрузки[p][i]+=root.busyArea*100.0/(4*30);
traceln("TANK;" + root.интенсивностьПрибытия+";"+root.правилоОчереди+";"+root.номерПовтора+";"+root.рейсыБензовоза+";"+root.полныеПополнения+";"+root.последнийУровеньДо+";"+root.последнийУровеньПосле+";"+root.перелитоВРезервуары+";"+root.времяПервогоСлива+";"+root.времяЗаполнения);</AfterSimulationRunCode>
			<SeedValue>625503</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs/>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>
			<Variables>

			<Variable Class="PlainVariable">
					<Id>1778677226398</Id>
					<Name>суммы</Name>
					<X>100</X><Y>0</Y>
					<Label><X>10</X><Y>0</Y></Label>
