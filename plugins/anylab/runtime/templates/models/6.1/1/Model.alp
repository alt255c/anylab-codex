					<Id>1435918262404</Id>
					<Name>fuelColor</Name>
					<X>50</X><Y>-1500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name>fuelType</Name>
						<Type>FuelType</Type>
					</Parameter>
					<Body>switch(fuelType){case GAS95:return new Color(0x7961A8);case GAS92:return new Color(0xB44F46);case DIESEL:return new Color(0x4E8C75);} return gray;</Body>
				</Function>
