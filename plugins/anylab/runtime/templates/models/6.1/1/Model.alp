		<Events><Event>
					<Id>1996200000020</Id>
					<Name>СнятьСтатистику</Name>
					<X>1300</X><Y>-1770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code>1</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code>1</Code>
							<Unit Class="RateUnits">PER_MINUTE</Unit>
						</Rate>
						<Id>1996200000021</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1792310400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code>0.01</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code>0.01</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</RecurrenceCode>
						<Condition>false</Condition>
					</Properties>
					<Action>
int ожидают=Math.max(0,доСтопЛинии+очередьККолонкам.size()-ресурсКолонок.idle());
queueArea+=ожидают*0.01; максимумОжидания=Math.max(максимумОжидания,ожидают);
busyArea+=ресурсКолонок.busy()*0.01; sampleCount++;
</Action>
				</Event>
			<Event>
					<Id>1996200000117</Id>
					<Name>ПроверитьТопливо</Name>
					<X>1300</X><Y>-1360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code>1</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code>1</Code>
							<Unit Class="RateUnits">PER_MINUTE</Unit>
						</Rate>
						<Id>1996200000118</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1792310400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code>0.1</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code>0.1</Code>
							<Unit Class="TimeUnits">MINUTE</Unit>
						</RecurrenceCode>
						<Condition>false</Condition>
					</Properties>
					<Action>
if (!бензовозВРаботе) {
 FuelType what = резервуарАИ92.amount(CUBIC_METER)&lt;3 ? GAS92 :
                 резервуарАИ95.amount(CUBIC_METER)&lt;3 ? GAS95 :
                 резервуарДТ.amount(CUBIC_METER)&lt;3 ? DIESEL : null;
 if (what!=null) {
  бензовозВРаботе=true; топливоСлива=what;
  бензовозТекущий=new GasolineTanker(what,30);
  приёмБензовоза.take(бензовозТекущий);
 }
}
</Action>
				</Event>
			</Events></ActiveObjectClass>

