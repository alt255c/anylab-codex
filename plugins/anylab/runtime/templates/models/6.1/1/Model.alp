						<Parameter>
							<Name>onEnter</Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
идётСлив=true;
if(времяПервогоСлива<0) времяПервогоСлива=time();
agent.pipeHose.setVisible( true );
//connect to the right tank - refilling starts immediately
switch( agent.fuelType ) {
case GAS95: топливныйПистолет.connect( заливАИ95 ); break;
case GAS92: топливныйПистолет.connect( заливАИ92 ); break;
case DIESEL: топливныйПистолет.connect( заливДТ ); break;
}
ShapeRectangle fitting = agent.fuelType==GAS95 ? приёмныйШтуцер0 :
    agent.fuelType==GAS92 ? приёмныйШтуцер1 : приёмныйШтуцер2;
fitting.setPos(agent.getX()+31, agent.getY()+6);
]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name>onExit</Name>
							<Value Class="CodeValue">
								<Code>идётСлив=false; agent.pipeHose.setVisible(false);</Code>
							</Value>
						</Parameter>
