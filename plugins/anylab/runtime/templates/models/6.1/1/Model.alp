							<Name>onEnter</Name>
						<Value Class="CodeValue"><Code>
Tank target = car.fuelType==GAS92 ? резервуарАИ92 : car.fuelType==GAS95 ? резервуарАИ95 : резервуарДТ;
последнийУровеньПосле=target.amount(CUBIC_METER);
перелитоВРезервуары+=последнийУровеньПосле-car.уровеньДоСлива;
if (последнийУровеньПосле&gt;=target.capacity(CUBIC_METER)-0.006) {
 полныеПополнения++; времяЗаполнения=time();
}
топливныйПистолет.disconnect();
target.set_maxRateOut(10,LITER_PER_SECOND);
рейсыБензовоза++; бензовозВРаботе=false; бензовозТекущий=null;
</Code></Value></Parameter>
