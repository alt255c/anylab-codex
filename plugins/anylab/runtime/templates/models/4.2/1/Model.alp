			<AfterExperimentCode><![CDATA[
java.util.Collections.sort(MyCollection, (a, b) -> {
    MyAgent m1 = (MyAgent) a;
    MyAgent m2 = (MyAgent) b;
    int c = Double.compare(m1.db_2, m2.db_2);
    return c != 0 ? c : Double.compare(m1.db_1, m2.db_1);
});

for (Object obj : MyCollection) {
    MyAgent m = (MyAgent) obj;
    if (m.db_4 <= 0) {
        traceln("Поток: " + (int)m.db_1 + " чел/ч — нет завершивших посещение");
        continue;
    }

    traceln(
        "Интенсивность улицы: " + (int)m.db_1 + " чел/ч"
        + " | Множитель: " + m.db_2
        + " | Среднее время в ТЦ: "
        + String.format("%.2f", m.db_3) + " мин"
        + " | Завершили: " + (int)m.db_4 + " чел."
    );

    if (Math.abs(m.db_2 - 0.5) < 0.0001) {
        Время05.add(m.db_1, m.db_3);
    }
    else if (Math.abs(m.db_2 - 1.0) < 0.0001) {
        Время10.add(m.db_1, m.db_3);
    }
    else if (Math.abs(m.db_2 - 1.5) < 0.0001) {
        Время15.add(m.db_1, m.db_3);
    }
}

]]></AfterExperimentCode>
