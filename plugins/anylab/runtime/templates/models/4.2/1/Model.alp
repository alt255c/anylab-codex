			<AfterExperimentCode><![CDATA[java.util.Collections.sort(
    MyCollection,
    (a, b) -> Double.compare(a.db_1, b.db_1)
);

for (MyAgent m : MyCollection) {
    if (m.db_4 <= 0) {
        traceln(
            "Интенсивность из метро: " + (int)m.db_1
            + " чел/ч | Нет завершивших посещение"
        );
        continue;
    }
    traceln(
        "Интенсивность из метро: " + (int)m.db_1 + " чел/ч"
        + " | Среднее время в ТЦ: "
        + String.format("%.2f", m.db_3) + " мин"
        + " | Завершили посещение: " + (int)m.db_4 + " чел."
    );
    ВремяПотокМетро.add(m.db_1, m.db_3);
}]]></AfterExperimentCode>
