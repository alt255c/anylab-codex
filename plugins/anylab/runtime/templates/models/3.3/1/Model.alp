			<AfterExperimentCode><![CDATA[Collections.sort(MyCollection, (tuple1, tuple2) -> 
 	Double.compare(((MyAgent) tuple1).getParameter("db_1"), 
                   ((MyAgent) tuple2).getParameter("db_1")));

int tupleSize = MyCollection.size();
double x = 0.0;
double Ymin = 0.0, Y = 0.0, Ymax = 0.0;
double YYmin = 0.0, YY = 0.0, YYmax = 0.0;
double Z = 0.0, ZY = 0.0, ZYY = 0.0;
int N = 0;

for (int i = 0; i < tupleSize; i++) {
    Z = ((MyAgent) MyCollection.get(i)).getParameter("db_1");
    
    if (x != Z) {
        if (N != 0) {
            Y = Y / N;
            YY = YY / N;
            
            traceln("Размер закупки = " + x + 
                    ", Издержки: min=" + Ymin + ", avg=" + Y + ", max=" + Ymax +
                    ", Прибыль: min=" + YYmin + ", avg=" + YY + ", max=" + YYmax +
                    ", Репликаций = " + N);
                    
            Мин_Издержки.add(x, Ymin);
            Mid_Издержки.add(x, Y);
            Макс_Издержки.add(x, Ymax);
            
            Мин_Прибыль.add(x, YYmin);
            Mid_Прибыль.add(x, YY);
            Макс_Прибыль.add(x, YYmax);
        }
        x = Z;
        Ymin = ((MyAgent) MyCollection.get(i)).getParameter("db_2");
        Y = Ymin;
        Ymax = Ymin;
        YYmin = ((MyAgent) MyCollection.get(i)).getParameter("db_3");
        YY = YYmin;
        YYmax = YYmin;
        N = 1;
    } else {
        N++;
        ZY = ((MyAgent) MyCollection.get(i)).getParameter("db_2");
        ZYY = ((MyAgent) MyCollection.get(i)).getParameter("db_3");
        
        if (Ymin > ZY) Ymin = ZY;
        if (Ymax < ZY) Ymax = ZY;
        Y = Y + ZY;
        
        if (YYmin > ZYY) YYmin = ZYY;
        if (YYmax < ZYY) YYmax = ZYY;
        YY = YY + ZYY;
    }
}

Y = Y / N;
YY = YY / N;

traceln("Размер закупки = " + x + 
        ", Издержки: min=" + Ymin + ", avg=" + Y + ", max=" + Ymax +
        ", Прибыль: min=" + YYmin + ", avg=" + YY + ", max=" + YYmax +
        ", Репликаций = " + N);
        
Мин_Издержки.add(x, Ymin);
Mid_Издержки.add(x, Y);
Макс_Издержки.add(x, Ymax);
Мин_Прибыль.add(x, YYmin);
Mid_Прибыль.add(x, YY);
Макс_Прибыль.add(x, YYmax);]]></AfterExperimentCode>
