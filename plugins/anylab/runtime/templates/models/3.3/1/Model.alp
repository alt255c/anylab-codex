			<Name><![CDATA[MyAgent]]></Name>
			<Text><![CDATA[public class MyAgent {
    public double db_1, db_2, db_3;
    
    public MyAgent(double db_1, double db_2, double db_3) {
        this.db_1 = db_1;
        this.db_2 = db_2;
        this.db_3 = db_3;
    }
    
    public double getParameter(String name) {
        if (name.equals("db_1")) return db_1;
        if (name.equals("db_2")) return db_2;
        if (name.equals("db_3")) return db_3;
        return 0;
    }
}]]></Text>
