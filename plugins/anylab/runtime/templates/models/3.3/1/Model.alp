						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Спрос = Math.floor(normal(250, 3300));

if (Спрос > РазмерЗакупки) {
    // ДЕФИЦИТ: продаём всё по нормальной цене, часть спроса не удовлетворена
    Недостаток = Спрос - РазмерЗакупки;
    Избыток = 0;
    Издержки = Издержки + Недостаток * (НормальнаяЦена - Себестоимость);
    Прибыль = Прибыль + (НормальнаяЦена - Себестоимость) * РазмерЗакупки;
} else {
    // ИЗБЫТОК: спрос удовлетворён полностью, остаток идёт на распродажу
    Избыток = РазмерЗакупки - Спрос;
    Недостаток = 0;
    Издержки = Издержки + Избыток * (Себестоимость - Распродажа);
    Прибыль = Прибыль + НормальнаяЦена * Спрос 
              + Распродажа * Избыток 
              - Себестоимость * РазмерЗакупки;
}
]]></Code>
							</Value>
